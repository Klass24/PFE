APP_NAME=FleetControl
APP_ENV=production
APP_KEY=base64:5PyMzGrIKfJ5DJOPwJnQGQtMzYK5CMzLXDzVUpRCMz4=
APP_DEBUG=false
APP_URL=http://localhost:8080

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
